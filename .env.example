# All optional. With nothing set, BrandProof runs locally on SQLite with rule-based checks only.
GEMINI_API_KEY=            # enables AI review, reading text in images, logo fallback, free-form brand-book import
GEMINI_MODEL=gemini-3.8-flash
DATABASE_URL=              # postgres://user:pass@host:5432/db  (leave empty to use SQLite)
DB_PATH=data/brandproof.db # SQLite file used when DATABASE_URL is empty
ADMIN_TOKEN=               # protects POST /api/benchmark/run (the AI accuracy run)
AI_MAX_CALLS_PER_MIN=12    # protects the free AI quota
